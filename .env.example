# Copy to .env and fill real values when ready (never commit)
#   cp .env.example .env
#
# Dashboard Setup stage writes the same keys into .streamlit/secrets.toml
# (interactive desk). Docker / headless reactor uses this .env file instead.

DEMO_MODE=true
# SETUP_COMPLETE=true   # optional; usually set via Dashboard Setup save

# Host-local default. docker-compose.yml overrides to redis://redis:6379/0 inside containers.
REDIS_URL=redis://localhost:6379/0

# Public feeds (demo / PoC — no Snowflake required)
# Open-Meteo needs no key. EIA is optional: https://www.eia.gov/opendata/
EIA_API_KEY=
DEMO_LAT=29.76
DEMO_LON=-95.37
DEMO_PLANT_ID=DEMO-PUBLIC-1
DEMO_HEAT_RATE=7.5
DEMO_NAMEPLATE_MW=500.0

# Snowflake (live system-of-record) — use write-capable role for ritual landing
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=ALPHAGEN_ETRM
SNOWFLAKE_SCHEMA=GOLD
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=           # optional session role
# Landing write policy:
#   - DEMO_MODE=true  → skip landing unless SNOWFLAKE_WRITE=true
#   - DEMO_MODE=false → write when credentials are configured
# SNOWFLAKE_WRITE=true      # force landing even in demo
# SNOWFLAKE_STAGING_WRITE=true  # dual-write STAGING_GAS_BURN (default false)
# SNOWFLAKE_READ=false      # disable cockpit/API SoR reads (default: on when configured)

# Temporal durable rituals (optional)
# Local: install Temporal CLI → temporal server start-dev → host localhost:7233
# Cloud: region host + API key (TLS auto when api_key set)
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=
# TEMPORAL_TASK_QUEUE=spire-reactor
# TEMPORAL_USE=true          # force dispatch even in DEMO_MODE
# TEMPORAL_TLS=false         # force TLS off for plain local frontend
# TEMPORAL_WORKFLOW_TIMEOUT=180
#
# Worker:
#   python -m spire_reactor.main --mode temporal
#   docker compose --profile temporal up -d --build

# Fusion notify + optional xAI (optional)
# WEBHOOK_URL=
# WEBHOOK_SECRET=
# XAI_API_KEY=
# XAI_MODEL=grok-2-latest
