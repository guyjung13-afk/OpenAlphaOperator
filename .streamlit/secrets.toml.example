# Copy to secrets.toml and fill real values (or use the Dashboard Setup stage).
#   copy .streamlit\secrets.toml.example .streamlit\secrets.toml
#
# NEVER commit secrets.toml — it is gitignored.
# Docker / headless API: use .env with the same logical keys instead.

[app]
demo_mode = true
setup_complete = false

